# Tailscale (required for docker compose sidecar)
TS_AUTHKEY=

# OpenClaw Gateway — server-side only (never VITE_*)
OPENCLAW_GATEWAY_URL=wss://openclaw.tiger-bushmaster.ts.net
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_HTTP_URL=https://openclaw.tiger-bushmaster.ts.net

# Prompt Engineer specialist (stronger model than main/Flash)
PROMPT_ENGINEER_AGENT_ID=prompt-engineer
PROMPT_ENGINEER_MODEL=openai/gpt-5.5
# PROMPT_ENGINEER_WORKSPACE=~/.openclaw/workspace-prompt-engineer

# Connected apps
DOCMOST_URL=https://docmost.tiger-bushmaster.ts.net
QUARTZ_URL=https://quartz.tiger-bushmaster.ts.net
SILVERBULLET_URL=https://silverbullet.tiger-bushmaster.ts.net

# MetaMCP (Tailnet aggregator)
METAMCP_API_KEY=

# Inventory page (/inventory) — server-side only, read-only Directus token
DIRECTUS_URL=https://cp.tiger-bushmaster.ts.net
DIRECTUS_INVENTORY_TOKEN=
